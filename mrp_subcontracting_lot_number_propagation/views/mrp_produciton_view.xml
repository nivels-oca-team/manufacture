<odoo>

  <record id="mrp_production_form_view_lot_producing_extend" model="ir.ui.view">
    <field name="name">mrp.production.form.view.lot.producing.extend</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view" />
    <field name="arch" type="xml">
      <label for="lot_producing_id" position="attributes">
        <attribute name="invisible">product_tracking in ('none', False)</attribute>
      </label>
      <xpath expr="//field[@name='lot_producing_id']/.." position="attributes">
        <attribute name="invisible">product_tracking in ('none', False)</attribute>
      </xpath>
      <field name="lot_producing_id" position="attributes">
        <attribute name="readonly">0</attribute>
        <attribute name="required">0</attribute>
      </field>
    </field>
  </record>

</odoo>
