<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_point_view_form_inherit_mrp_inherit" model="ir.ui.view">
        <field name="name">quality.point.view.form.inherit.mrp.inherit</field>
        <field name="model">quality.point</field>
        <field name="inherit_id" ref="mrp_workorder.quality_point_view_form_inherit_mrp"/>
        <field name="arch" type="xml">
            <field name="test_report_type" position="after">
                <field name="display_test_report_id" invisible="1" />
                <field name="test_report_id_domain" invisible="1" />
                <field name="test_report_id"
                       invisible="not display_test_report_id"
                       domain="test_report_id_domain" />
            </field>
        </field>
    </record>
</odoo>
