<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workorder_view_form_tablet_inherit" model="ir.ui.view">
        <field name="name">mrp.workorder.view.form.inherit.quality.tablet.new.inherit</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp_workorder.mrp_workorder_view_form_tablet" />
        <field name="arch" type="xml">
            <field name="current_quality_check_id" position="after">
                <field name="display_lots_on_hand_first" invisible="1"/>
            </field>
            <xpath expr="//div[hasclass('o_workorder_lot')]//field[@name='finished_lot_id']" position="attributes">
                <attribute
                name="context"
                operation="update"
            >{'name_search_qty_on_hand_first': display_lots_on_hand_first}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
